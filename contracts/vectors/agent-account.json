      "operation": false,
      "expected": {
        "enabled": false,
        "items": [
          [
            "switch:login",
            "Switch account"
          ]
        ]
      }
    },
    {
      "name": "a configuration change in flight blocks the change",
      "reauthMethods": [
        {
          "id": "login",
          "name": "Claude Subscription",
          "terminal": true
        }
      ],
      "canSignOut": false,
      "paneState": "idle",
      "connected": true,
      "operation": true,
      "expected": {
        "enabled": false,
        "items": [
          [
            "switch:login",
            "Switch account"
          ]
        ]
      }
    },
    {
      "name": "a lost connection blocks the change",
