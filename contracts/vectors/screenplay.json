    { "name": "a shot does not take a second colon", "kind": "shot", "source": "close up:", "line": "CLOSE UP:" },
    { "name": "action is trimmed", "kind": "action", "source": "  She walks in ", "line": "She walks in" },
    { "name": "action loses a marker that forced another element", "kind": "action", "source": "@She walks in", "line": "She walks in" },
    { "name": "dialogue is trimmed", "kind": "dialogue", "source": " Hello there ", "line": "Hello there" }
  ],
