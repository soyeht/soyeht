    { "name": "a character takes the accents upper case", "kind": "character", "source": "josé", "line": "@JOSÉ" },
    { "name": "a forced character is not forced twice", "kind": "character", "source": "@ana", "line": "@ANA" },
    { "name": "a parenthetical is in parentheses", "kind": "parenthetical", "source": "quietly", "line": "(quietly)" },
    { "name": "a parenthetical keeps its parentheses once", "kind": "parenthetical", "source": "(quietly)", "line": "(quietly)" },
