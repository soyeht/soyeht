    {
      "name": "the engine is not running",
      "connected": false,
      "result": null,
      "expected": {
        "complete": false,
        "blockers": 1,
        "headline": "The Soyeht engine is not running",
        "rows": [
          {
            "id": "engine",
            "title": "Soyeht engine",
            "kind": "engine",
            "required": true,
            "state": "missing"
          }
        ]
      }
    },
