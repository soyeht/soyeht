      "additionalProperties": true
    },
    "Pane": {
      "type": "object",
      "properties": {
        "paneId": {
          "$ref": "#/$defs/Id"
        },
        "workspaceId": {
          "$ref": "#/$defs/Id"
        },
        "name": {
          "type": "string"
        },
        "cwd": {
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/PaneMode"
        },
        "state": {
          "$ref": "#/$defs/PaneState"
        },
        "source": {
          "$ref": "#/$defs/StateSource"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "phrase": {
          "type": "string"
        },
        "generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "cols": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "rows": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "record": {
          "type": "boolean"
        },
        "pid": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "streamId": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "paneId",
        "workspaceId",
        "name",
        "cwd",
        "mode",
        "state",
        "source",
        "confidence",
        "phrase",
        "generation",
        "cols",
        "rows",
        "record"
      ],
      "additionalProperties": true
    },
    "Device": {
      "type": "object",
      "properties": {
        "deviceId": {
          "$ref": "#/$defs/Id"
        },
        "name": {
          "type": "string"
        },
        "fingerprint": {
          "type": "string"
        },
        "revoked": {
          "type": "boolean"
        }
      },
      "required": [
        "deviceId",
        "name",
        "fingerprint",
        "revoked"
      ],
      "additionalProperties": true
    },
    "StreamInfo": {
      "type": "object",
      "properties": {
        "streamId": {
          "$ref": "#/$defs/Id"
        },
        "paneId": {
          "$ref": "#/$defs/Id"
        },
        "generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "firstRetainedOffset": {
          "$ref": "#/$defs/Decimal"
        },
        "nextOffset": {
          "$ref": "#/$defs/Decimal"
        },
        "binaryPaneRef": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
