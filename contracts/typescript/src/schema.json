        "dbId": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "engineVersion",
        "protocolVersion",
        "connectionId",
        "role",
        "capabilities",
        "dbId"
      ],
      "additionalProperties": true
    },
    "Empty": {
      "type": "object",
      "properties": {},
