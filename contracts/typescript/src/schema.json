{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soyeht.invalid/protocol/v1",
  "title": "Soyeht slice 1 protocol",
  "description": "Wire schema. x-methods and x-events associate JSON-RPC names with schemas. See README.md for supported vocabulary.",
  "$defs": {
    "JsonValue": {},
    "Id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "Decimal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "maxLength": 20
    },
    "ByteString": {
      "type": "string",
      "contentEncoding": "base64"
    },
    "Role": {
      "type": "string",
      "enum": [
        "human_local",
        "human_device",
        "agent",
        "chief"
      ]
    },
    "PaneMode": {
      "type": "string",
      "enum": [
        "terminal",
        "agent"
      ]
    },
    "PaneState": {
      "type": "string",
      "enum": [
        "iniciando",
        "trabalhando",
        "ociosa",
        "esperando_você",
        "cancelando",
        "sem_sinal",
        "recuperando",
        "morta",
        "não_sei"
      ]
    },
    "StateSource": {
      "type": "string",
      "enum": [
        "protocol",
        "hook",
        "osc",
        "screen",
        "none"
      ]
    },
    "SnapshotSection": {
      "type": "string",
      "enum": [
        "workspaces",
        "panes",
        "tasks",
        "requests",
        "attention",
        "devices",
        "capabilities",
        "streams"
      ]
    },
    "ErrorKind": {
      "type": "string",
      "enum": [
        "not_found",
        "invalid_params",
        "unauthorized",
        "forbidden_role",
        "pane_busy",
        "task_has_owner",
        "transition_refused",
        "stale_version",
        "idempotency_conflict",
        "harness_unavailable",
        "needs_login",
        "cursor_too_old",
        "resync_required",
        "slow_consumer",
        "protocol_version_unsupported",
        "disk_full",
        "ptyd_unavailable",
        "stale_engine_generation",
        "internal_error",
        "snapshot_too_large"
      ]
    },
    "RpcError": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer"
        },
        "message": {
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/ErrorData"
        }
      },
      "required": [
        "code",
        "message",
        "data"
      ],
      "additionalProperties": true
    },
    "ErrorData": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ErrorKind"
        },
        "detail": {
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": true
    },
    "Actor": {
      "type": "object",
      "properties": {
        "role": {
          "$ref": "#/$defs/Role"
        },
        "client": {
          "type": "string"
        },
        "deviceId": {
          "$ref": "#/$defs/Id"
        },
        "paneId": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "role",
        "client"
      ],
      "additionalProperties": true
    },
    "Workspace": {
      "type": "object",
      "properties": {
        "workspaceId": {
          "$ref": "#/$defs/Id"
        },
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "layout": {
