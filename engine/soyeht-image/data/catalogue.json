{
  "entries": [
    {
      "id": "qwen-image-2.1-comfyui",
      "name": "Qwen-Image 2.1 edit on ComfyUI",
      "summary": "Edits the picture on a ComfyUI server of your own, on this computer or another one of yours. Nothing leaves your computers.",
      "locality": "local",
      "adapter": "comfyui",
      "model": "qwen-image-2.1",
      "endpoint": "http://127.0.0.1:8188",
      "needsKey": false,
      "timeoutSeconds": 900,
      "sizeMultiple": 16,
      "license": {"name": "Qwen Research License Agreement", "commercialUse": false},
      "sends": [],
      "recipe": {
        "bindings": {
          "image": ["470", "image"],
          "prompt": ["459:474", "prompt"],
          "seed": ["459:458", "seed"],
          "width": ["459:456", "width"],
          "height": ["459:456", "height"],
          "output": "461"
        },
        "graph": {
          "470": {"class_type": "LoadImage", "inputs": {"image": ""}},
          "459:451": {"class_type": "UNETLoader", "inputs": {"unet_name": "qwen_image_2.1_int8_convrot.safetensors", "weight_dtype": "default"}},
          "459:453": {"class_type": "CLIPLoader", "inputs": {"clip_name": "qwen3vl_8b_int8_convrot.safetensors", "type": "qwen_image", "device": "default"}},
          "459:454": {"class_type": "VAELoader", "inputs": {"vae_name": "qwen_image_2.1_vae_bf16.safetensors"}},
          "459:469": {"class_type": "QwenImage21Cache", "inputs": {"model": ["459:451", 0], "device": "auto", "dtype": "default"}},
          "459:474": {"class_type": "TextEncodeQwenImage21", "inputs": {"clip": ["459:453", 0], "vae": ["459:454", 0], "prompt": "", "negative_prompt": "", "resolution": 0, "images.image_1": ["470", 0]}},
          "459:456": {"class_type": "EmptyLatentImage", "inputs": {"width": 1024, "height": 1024, "batch_size": 1}},
          "459:468": {"class_type": "ComfySwitchNode", "inputs": {"switch": true, "on_false": ["459:474", 2], "on_true": ["459:456", 0]}},
          "459:458": {"class_type": "KSampler", "inputs": {"model": ["459:469", 0], "positive": ["459:474", 0], "negative": ["459:474", 1], "latent_image": ["459:468", 0], "seed": 1, "steps": 25, "cfg": 1, "sampler_name": "euler", "scheduler": "simple", "denoise": 1}},
          "459:457": {"class_type": "VAEDecode", "inputs": {"samples": ["459:458", 0], "vae": ["459:454", 0]}},
          "461": {"class_type": "SaveImageAdvanced", "inputs": {"images": ["459:457", 0], "filename_prefix": "soyeht-avatar", "format": "png", "format.bit_depth": "8-bit", "format.input_color_space": "sRGB"}}
        }
      }
    },
    {
      "id": "openai-compatible-image-edit",
      "name": "Image edit endpoint (OpenAI-compatible)",
      "summary": "Edits the picture through any service that answers the OpenAI image-edit request. You give the address, the model name and your own key. The picture and the instructions are sent to that service.",
      "locality": "cloud",
      "adapter": "openai-images",
      "needsKey": true,
      "timeoutSeconds": 300,
      "sizeMultiple": 1,
      "license": {"name": "The provider's terms"},
      "sends": ["picture", "text"]
    }
  ]
}
