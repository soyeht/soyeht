<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Asked for when the person taps Scan, never before. A phone without a camera still pairs by link. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- The credential is the phone's own: it is neither backed up nor moved to another phone. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:label="Soyeht Dev"
        android:theme="@style/Theme.Soyeht">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="soyeht-next" android:host="pair" />
            </intent-filter>
        </activity>

        <!--
            Google ML Kit (handwriting on this device, off by default, ADR 0157) starts itself at launch through this
            provider. It is removed: the app starts ML Kit (MlKit.initialize) only after the person turns the
            recognizer on. The service that lists ML Kit's components stays, because ML Kit reads it when it starts;
            nothing runs it.
        -->
        <provider
            android:name="com.google.mlkit.common.internal.MlKitInitProvider"
            android:authorities="${applicationId}.mlkitinitprovider"
            tools:node="remove" />
    </application>
</manifest>
