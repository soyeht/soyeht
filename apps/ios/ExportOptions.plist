<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The export of the App Store build (scripts/package_ios.py, docs/apps-iphone.md). The script
	     adds the team (SOYEHT_DEVELOPMENT_TEAM) and the signing identity (SOYEHT_IOS_SIGNING_IDENTITY)
	     from the environment to a copy of this file; neither is ever written here. -->
	<key>method</key>
	<string>app-store-connect</string>
	<key>destination</key>
	<string>export</string>
	<!-- The build number is the one of contracts/release.json; Xcode must not raise it. -->
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
	<key>signingStyle</key>
	<string>manual</string>
	<key>signingCertificate</key>
	<string>Apple Distribution</string>
	<!-- The App Store profile of the identifier, made in the developer account. -->
	<key>provisioningProfiles</key>
	<dict>
		<key>com.soyeht.next.ios</key>
		<string>Soyeht Next iOS App Store</string>
	</dict>
</dict>
</plist>
