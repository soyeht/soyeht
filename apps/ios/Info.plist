<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>$(SOYEHT_PRODUCT_NAME)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- Only standard encryption: TLS through the system, the tailnet, and CryptoKit signatures and hashes. Nothing here needs an export-compliance document. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>SoyehtLicense</key>
	<string>Apache-2.0</string>
	<key>NSCameraUsageDescription</key>
	<string>Scan the QR shown by Soyeht on the Mac to pair this iPhone or iPad.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Dictate messages to your agents: Soyeht listens only while the composer's mic is on.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Turn what you say into text in the agent composer. Soyeht asks Apple's speech recognition to work on this device when your language supports it; otherwise Apple may process the audio.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Connect to your own computer that runs Soyeht, to show and control its terminals and agents.</string>
	<!-- HTTP and WebSocket use tailnet encryption. The parser only accepts tailnet and loopback addresses. Contract 06.
	     This exception is still needed: ATS exempts loopback and the fd7a: tailnet addresses, but not the 100.64.0.0/10
	     addresses Tailscale gives a device (checked on the iOS 18.6 simulator: ws:// to 100.64.0.1 fails with
	     NSURLErrorDomain -1022 without it, and NSAllowsLocalNetworking does not cover it). -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIAppFonts</key>
	<array>
		<string>Fonts/Newsreader.ttf</string>
		<string>Fonts/Newsreader-Italic.ttf</string>
		<string>Fonts/Nunito-Regular.ttf</string>
		<string>Fonts/Nunito-SemiBold.ttf</string>
		<string>Fonts/Nunito-Bold.ttf</string>
		<string>Fonts/CourierPrime-Regular.ttf</string>
		<string>Fonts/CourierPrime-Bold.ttf</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- iPad keeps every orientation and no UIRequiresFullScreen, so Split View and Stage Manager work. -->
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER).pair</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>soyeht-next</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
